{
  "name": "event-manager",
  "version": "1.0.0",
  "description": "Gerenciador de Eventos com TypeScript e MongoDB",
  "main": "dist/app.js",
  "scripts": {
    "start": "ts-node src/app.ts",
    "build": "tsc",
    "serve": "node dist/app.js",
    "dev": "concurrently \"npm:start\" \"sleep 3 && npm run open-frontend\"", 
    "open-frontend": "open-cli http://localhost:3000"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^20.14.2",
    "concurrently": "^9.2.1",
    "open-cli": "^8.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
